{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-edit.sh",
            "timeout": 10,
            "statusMessage": "Checking the edit against CLAUDE.md rules"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-commit.sh",
            "if": "Bash(git commit *)",
            "timeout": 10,
            "statusMessage": "Checking staged file sizes"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 -c ' *)"
    ]
  }
}
